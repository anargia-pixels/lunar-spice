{
  "name": "lunar-spice",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.6.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "@hugeicons/core-free-icons": "^4.3.5",
      "@hugeicons/react": "^1.1.10",
      "@oxlint/plugins": "^1.81.0",
      "@shadcn/lint": "^0.1.0",
      "@shadcn/react": "^0.3.1",
      "@tailwindcss/vite": "^4.1.18",
      "@types/bun": "^1.3.4",
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.4.0",
      "electron-builder": "26.15.3",
      "framer-motion": "^14.0.0",
      "oxfmt": "^0.64.0",
      "oxlint": "^1.81.0",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "react-resizable-panels": "^4.18.0",
      "shadcn": "^4.21.0",
      "tailwindcss": "^4.1.18",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "zustand": "^5.0.14"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "turbo -F desktop dev",
    "dev:web": "turbo -F web dev",
    "build": "turbo build",
    "test": "bun test",
    "clean": "find . -name .git -prune -o \\( -name node_modules -o -name dist -o -name build -o -name out -o -name .turbo -o -name .cache -o -name .vite -o -name coverage -o -name '*.tsbuildinfo' \\) -prune -exec rm -rf -- {} +",
    "package:linux": "bun run --cwd apps/desktop package --linux zip --x64",
    "package:macos:arm64": "bun run --cwd apps/desktop package --mac dmg --arm64",
    "check-types": "turbo check-types",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix ."
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.9.18",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
